# Qwen3-TTS Interactive Demo Configuration
# Copy this file to .env and fill in your values

# Required: Your Qwen3-TTS API authentication token
# Get this from your API provider
QWEN_TTS_AUTH_TOKEN=your_auth_token_here

# Optional: Qwen3-TTS API base URL (from Simplismart deployment page)
QWEN_TTS_BASE_URL=https://YOUR-SIMPLISMART-ENDPOINT

# Optional: Flask server configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
